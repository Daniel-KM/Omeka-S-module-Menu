<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var array $options Options provided to the helper, merged with default values.
 * @var array $links Ordered crumbs (root to leaf); each has "label", "title", "uri", "active", "no_link", "resource".
 * @var string $separator Separator glyph, decorative (wrapped in aria-hidden below).
 * @var string $ariaLabel Accessible label for the breadcrumb nav.
 * @var string $schema Schema.org BreadcrumbList JSON, or "" when disabled.
 *
 * @var \Laminas\Navigation\Navigation $breadcrumbs Container, kept for old themes.
 * @var array $crumbs Flat crumb list, kept for old themes.
 */

if (empty($links)) {
    return;
}

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$this->headLink()->appendStylesheet($this->assetUrl('css/menu.css', 'Menu'));

$linkLast = !empty($options['linkLast']);

// The separator is decorative: wrap it in an aria-hidden span so it is not
// announced by screen readers.
$sep = ' <span class="breadcrumb-separator" aria-hidden="true">'
    . $escape($separator)
    . "</span>\n";

$parts = [];
foreach ($links as $crumb) {
    $label = $escape($crumb['label']);
    $title = $crumb['title'] !== ''
        ? ' title="' . $escapeAttr($crumb['title']) . '"'
        : '';
    if ($crumb['active'] && !$linkLast) {
        $parts[] = '<span class="active" aria-current="page"' . $title . '>' . $label . '</span>';
    } elseif ($crumb['no_link']) {
        $parts[] = '<span class="no-link"' . $title . '>' . $label . '</span>';
    } else {
        $aria = $crumb['active'] ? ' aria-current="page"' : '';
        $parts[] = '<a href="' . $escapeAttr($crumb['uri']) . '"' . $title . $aria . '>' . $label . '</a>';
    }
}
$html = implode($sep, $parts);
?>

<div class="breadcrumbs-parent">
    <nav id="breadcrumb" class="breadcrumbs" aria-label="<?= $escapeAttr($ariaLabel) ?>">
        <?= $html ?>
    </nav>
    <?php if ($schema !== ''): ?>
    <script type="application/ld+json"><?= $schema ?></script>
    <?php endif; ?>
</div>
